NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=brain_agriculture
# true se o Postgres exigir SSL (ex.: conexão externa a partir de fora do Render)
DATABASE_SSL=false

# Origem permitida para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Autenticação JWT (troque JWT_SECRET em produção)
JWT_SECRET=dev-secret-troque-em-producao
JWT_EXPIRES_IN=8h
